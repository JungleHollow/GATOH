}

@article{Hegselmann2002,
	author = {Hegselmann, Rainer and Krause, Ulrich},
	journal = {Journal of Artificial Societies and Social Simulation},
	title = {Opinion dynamics and bounded confidence: models, analysis, and simulation},
	year = {2002},
	volume = {5},
	number = {3},
	keywords = {Opinion dynamics;Consensus/dissent;Bounded confidence; Nonlinear dynamical systems},
	abstract = {When does opinion formation within an interacting group lead to consensus,
	polarization or fragmentation? The article investigates various models for the dynamics
	of continuous opinions by analytical methods as well as by computer simulations. Sec-
	tion 2 develops within a unified framework the classical model of consensus formation,
	the variant of this model due to Friedkin and Johnsen, a time-dependent version and a
	nonlinear version with bounded confidence of the agents. Section 3 presents for all
	these models major analytical results. Section 4 gives an extensive exploration of the
	nonlinear model with bounded confidence by a series of computer simulations. An ap-
	pendix supplies needed mathematical definitions, tools, and theorems.}
}

@article{Peng2023,
	title = {On The Role of Community Structure in Evolution of Opinion Formation: A New Bounded Confidence Opinion Dynamics},
	journal = {Information Sciences},
	volume = {621},
	pages = {672-690},
	year = {2023},
	issn = {0020-0255},
	doi = {https://doi.org/10.1016/j.ins.2022.11.101},
	url = {https://www.sciencedirect.com/science/article/pii/S0020025522013913},
	author = {Yuan Peng and Yiyi Zhao and Jiangping Hu},
	keywords = {Opinion dynamics, Community structure, Bounded confidence, Complex social network},
	abstract = {The process of opinion formation and evolution is an important part of the study of opinion dynamics. However, the existing opinion dynamics ignore the relationship between opinion evolution and community structure. To address the limitation, we build a novel bounded confidence opinion dynamics model (called LPA-HK for simplicity). Based on the Hegselmann-Krause (HK) model, the label propagation algorithm (LPA) is introduced in the LPA-HK model to study the relationship between opinion evolution and community partition from the micro-perspective of the evolutionary process. Each agent has an opinion as well as a label indicating the agent’s community. The iterations of agents’ states involve two stages: label and opinion updates. The labels and opinions of agents evolve dynamically until the group reaches a stable state. We perform simulations to examine the effect of the model parameters on opinion evolution and community partitions. We show that group reaches a consensus as the confidence level increases to a critical value and the partitions of high quality are obtained when the confidence level is greater than the critical value. We apply the LPA-HK model to three kinds of real networks to solve the community detection problem. The effectiveness of the LPA-HK model is verified by comparing the results with two existing community detection results based on modularity optimization algorithms.}
}

@article{Peng2025,
	title = {Adaptive opinion dynamics over community networks when agents cannot express opinions freely},
	journal = {Neurocomputing},
	volume = {618},
	pages = {129123},
	year = {2025},
	issn = {0925-2312},
	doi = {https://doi.org/10.1016/j.neucom.2024.129123},
	url = {https://www.sciencedirect.com/science/article/pii/S0925231224018940},
	author = {Yuan Peng and Yiyi Zhao and Jianglin Dong and Jiangping Hu},
	keywords = {Opinion dynamics, Community network, Bounded confidence rule, Expressed and private opinions, Spiral of silence},
	abstract = {In this paper, based on the Spiral of Silence (SOS) theory, we propose a novel dynamic weight expressed and private opinion dynamics model (called DWEPO for simplicity) for social networks with community structures. We introduce a dynamic weight to enable the quantification of the indicators of opinion climate, quasi-sensory statistics, and fear of isolation index in SOS theory. When updating private opinions, agents adjust their confidence levels based on the communities to which their neighbors belong. When updating expressed opinions, agents adjust the dynamic weights based on the opinion climate within their communities. We conducted simulations of our model on two real networks and one synthetic network, and compared it with the Inertial Hegselmann–Krause (IHK) model and the original EPO model. The results show that our model is more conducive to opinion convergence and portrays the process of agent “silencing” in a group well. The DWEPO model can realize the consensus of agents in the community through confidence level settings. When an agent becomes “silent,” its opinion climate, quasi-sensory statistics and fear of isolation index decrease accordingly. When an agent’s opinion dominates the community, the opinion climate and fear of isolation index change from positive to negative.}
}

@article{Davis2024,
	author = {Davis, Natalie and Dermody, Brian and Koetse, Mark and van Voorn, George A.K.},
	title = {Identifying Personal and Social Drivers of Dietary Patterns: An Agent-Based Model of Dutch Consumer Behavior},
	journal = {Journal of Artificial Societies and Social Simulation},
	volume = {27},
	number = {1},
	pages = {1--29},
	issn = {1460-7425},
	doi = {10.18564/jasss.5020},
	url = {http://jasss.soc.surrey.ac.uk/27/1/4.html},
	abstract = {Understanding the drivers of dietary decisions is crucial for encouraging and facilitating environmentally sustainable consumption patterns. Previous work has focused on the utility that consumers place on factors such as price, quality, and ethics when making dietary decisions, or on the effects of personal values and peer influence on consumption of individual products. However, less attention has been paid to the interacting roles of values, perceptions, and social networks in dietary decision-making, and how these relate to mismatches between values and diet choice. Here, we develop an agent-based model of individual consumers making choices between five possible diets: omnivore, flexitarian, pescatarian, vegetarian, or vegan. Each consumer makes decisions based on personal constraints and values, and their perceptions of how well each diet matches with those values. Consumers can also be influenced by each other’s perceptions via interaction across three social networks: household members, friends, and acquaintances. We show that consumers primarily make decisions based on cost and taste, even when they value ethics and health, and illustrate three potential causes of the ‘attitude-behavior gap’ between ethical motivations and diet choice. This highlights the potential for both policy-driven changes to pricing structures, and increased awareness around sustainability and health attributes of different diets, in overcoming constraints and misperceptions to facilitate transitions to sustainable diets.},
	year = {2024}
}

